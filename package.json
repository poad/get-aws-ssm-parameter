{
  "name": "get-aws-ssm-parameter",
  "version": "3.1.0",
  "private": true,
  "description": "Get AWS SSM Parameter action",
  "type": "module",
  "main": "lib/main.js",
  "scripts": {
    "build": "swc --delete-dir-on-start --extensions .ts src -d lib --strip-leading-paths",
    "clean": "rm -rf dist lib",
    "lint": "oxlint",
    "lint-fix": "oxlint --fix",
    "format": "oxfmt --check",
    "package": "ncc build --license licenses.txt -m -q --target es2023",
    "test": "vitest run",
    "all": "pnpm build && pnpm package"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/actions/typescript-action.git"
  },
  "keywords": [
    "actions",
    "node",
    "setup"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@aws-sdk/client-ssm": "^3.1162.0",
    "source-map-support": "^0.5.21"
  },
  "devDependencies": {
    "@swc/cli": "^0.8.2",
    "@swc/core": "^1.16.22",
    "@swc/helpers": "^0.5.24",
    "@types/node": "^26.6.6",
    "@vercel/ncc": "^0.45.0",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.91.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.19.0",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "^26.13.1",
      "onFail": "download"
    }
  }
}
